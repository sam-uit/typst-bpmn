<?xml version="1.0" encoding="UTF-8"?>
<!--
  Synthetic fixture: vertical (isHorizontal="false") pools and lanes.

  Hand-written rather than exported, because vertical pools are rare enough that
  we had no real model using them and the renderer's vertical branch was never
  exercised. Geometry follows the convention Camunda uses for vertical pools:
  the title band runs along the top, lanes are columns, flow runs top to bottom.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0"
                  id="Definitions_vertical" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_v">
    <bpmn:participant id="P_customer" name="Khách hàng" processRef="Proc_customer" />
    <bpmn:participant id="P_bank" name="Ngân hàng" processRef="Proc_bank" />
    <bpmn:messageFlow id="MF_request" sourceRef="T_send" targetRef="T_receive" />
    <bpmn:messageFlow id="MF_reply" sourceRef="T_verify" targetRef="E_done" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_customer">
    <bpmn:startEvent id="E_start" name="Cần mở tài khoản">
      <bpmn:outgoing>F_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_send" name="Gửi yêu cầu mở tài khoản">
      <bpmn:incoming>F_1</bpmn:incoming>
      <bpmn:outgoing>F_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_done" name="Tài khoản đã mở">
      <bpmn:incoming>F_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_1" sourceRef="E_start" targetRef="T_send" />
    <bpmn:sequenceFlow id="F_2" sourceRef="T_send" targetRef="E_done" />
  </bpmn:process>

  <bpmn:process id="Proc_bank">
    <bpmn:laneSet id="LaneSet_bank">
      <bpmn:lane id="L_teller" name="Giao dịch viên">
        <bpmn:flowNodeRef>T_receive</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_audit" name="Hậu kiểm">
        <bpmn:flowNodeRef>T_verify</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="T_receive" name="Tiếp nhận hồ sơ">
      <bpmn:outgoing>F_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_verify" name="Thẩm định và mở tài khoản">
      <bpmn:incoming>F_3</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F_3" sourceRef="T_receive" targetRef="T_verify" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_v">
    <bpmndi:BPMNPlane id="BPMNPlane_v" bpmnElement="Collaboration_v">
      <bpmndi:BPMNShape id="P_customer_di" bpmnElement="P_customer" isHorizontal="false">
        <dc:Bounds x="160" y="80" width="260" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_bank_di" bpmnElement="P_bank" isHorizontal="false">
        <dc:Bounds x="480" y="80" width="440" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_teller_di" bpmnElement="L_teller" isHorizontal="false">
        <dc:Bounds x="480" y="110" width="220" height="450" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_audit_di" bpmnElement="L_audit" isHorizontal="false">
        <dc:Bounds x="700" y="110" width="220" height="450" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="E_start_di" bpmnElement="E_start">
        <dc:Bounds x="272" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="250" y="195" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_send_di" bpmnElement="T_send" color:background-color="#BBDEFB" color:border-color="#0D4372">
        <dc:Bounds x="240" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_done_di" bpmnElement="E_done" color:background-color="#C8E6C9" color:border-color="#205022">
        <dc:Bounds x="272" y="440" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="252" y="483" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_receive_di" bpmnElement="T_receive">
        <dc:Bounds x="540" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_verify_di" bpmnElement="T_verify">
        <dc:Bounds x="760" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="F_1_di" bpmnElement="F_1">
        <di:waypoint x="290" y="188" />
        <di:waypoint x="290" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_2_di" bpmnElement="F_2">
        <di:waypoint x="290" y="340" />
        <di:waypoint x="290" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_3_di" bpmnElement="F_3">
        <di:waypoint x="640" y="300" />
        <di:waypoint x="760" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_request_di" bpmnElement="MF_request">
        <di:waypoint x="340" y="300" />
        <di:waypoint x="540" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_reply_di" bpmnElement="MF_reply" color:border-color="#205022">
        <di:waypoint x="810" y="340" />
        <di:waypoint x="810" y="400" />
        <di:waypoint x="290" y="400" />
        <di:waypoint x="290" y="440" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
