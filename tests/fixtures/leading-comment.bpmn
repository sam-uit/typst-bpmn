<?xml version="1.0" encoding="UTF-8"?>
<!--
  Regression fixture for the XML root lookup.

  Typst's xml() returns every top-level node, so a comment ahead of the root
  shows up as an entry with an empty tag. bpmn-from-xml used to take the first
  entry and walk the comment instead of the model, producing an empty diagram.

  Do not round-trip this file through a modeler: saving it would strip the
  comment and with it the thing being tested. Keep it hand-edited and minimal.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_comment" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Proc_c" isExecutable="false">
    <bpmn:startEvent id="c_start" name="Bắt đầu">
      <bpmn:outgoing>c_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="c_task" name="Làm việc gì đó">
      <bpmn:incoming>c_f1</bpmn:incoming>
      <bpmn:outgoing>c_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="c_end" name="Kết thúc">
      <bpmn:incoming>c_f2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="c_f1" sourceRef="c_start" targetRef="c_task" />
    <bpmn:sequenceFlow id="c_f2" sourceRef="c_task" targetRef="c_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_c">
    <bpmndi:BPMNPlane id="BPMNPlane_c" bpmnElement="Proc_c">
      <bpmndi:BPMNShape id="c_start_di" bpmnElement="c_start">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_task_di" bpmnElement="c_task">
        <dc:Bounds x="250" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_end_di" bpmnElement="c_end">
        <dc:Bounds x="410" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="c_f1_di" bpmnElement="c_f1">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="250" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c_f2_di" bpmnElement="c_f2">
        <di:waypoint x="350" y="118" />
        <di:waypoint x="410" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
